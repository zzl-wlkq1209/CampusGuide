SITE_URL=https://bit-campusguide.netlify.app
CREDENTIAL_AGENT_KEY=与Netlify中相同的长随机字符串
REQABLE_PATH=D:\Software\5_Utilities\Reqable\Reqable.exe
CREDENTIAL_CAPTURE_FILE=C:\Users\你的用户名\CampusGuide\credential-response.json
REQABLE_CAPTURE_DIR=C:\Users\你的用户名\AppData\Roaming\Reqable\capture
# 通常无需填写；代理默认通过 weixin:// 打开，并在完成后关闭小程序宿主。
CHARGING_OPEN_COMMAND=
# 留空：默认不关闭微信或车充安，避免影响登录状态。
CHARGING_CLOSE_COMMAND=
AGENT_POLL_MS=3000
CAPTURE_TIMEOUT_MS=60000
REQABLE_READY_DELAY_MS=8000
REOPEN_DELAY_MS=12000
