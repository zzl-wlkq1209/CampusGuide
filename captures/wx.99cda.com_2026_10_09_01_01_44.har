nitial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no\" />\r\n\t\t<title>启动充电</title>\r\n\t\t<link rel=\"stylesheet\" href=\"css/weui.min.css?v=20241209\">\r\n\t\t<link rel=\"stylesheet\" href=\"css/jquery-weui.min.css?v=20241209\">\r\n\t\t<link rel=\"stylesheet\" href=\"css/style.css?v=20241209\">\r\n\t\t<link rel=\"stylesheet\" href=\"css/startChargeBoxInsurance.css?v=20241209\">\r\n\t\t<style type=\"text/css\">\r\n\t\t\t.cdfs li a {\r\n\t\t\t\tdisplay: block;\r\n\t\t\t\t/* padding: 10px; */\r\n\t\t\t\tfont-size: small;\r\n\t\t\t\tborder-width: 1px 1px 1px 1px;\r\n\t\t\t}\r\n\t\t\t.nbvs li .nvs {\r\n  \t\t\t\tpadding: 6px 0;\r\n  \t\t\t}\r\n  \t\t\tp{\r\n  \t\t\t\tfont-size: 10px;\r\n\t\t\t  \tmargin-bottom: 0em;\r\n  \t\t\t}\r\n  \t\t\t.weui-cells{\r\n  \t\t\t\tfont-size: 14px;\r\n\t        }\r\n\t        .chargeRateMode{\r\n\t          width:75%;\r\n\t          position:fixed;\r\n\t          top:20%;\r\n\t          left:50%;\r\n\t          transform: translate(-50%);\r\n\t          background:#fff;\r\n\t          text-align:center;\r\n\t          border-radius:5%;\r\n\t          padding:0 20px;\r\n\t          z-index:99989;\r\n\t        }\r\n\t        .chargeRateTitle{\r\n\t          font-size:16px;\r\n\t          color:#D86B4A;\r\n\t          line-height:40px;\r\n\t        }\r\n\t        .dn{\r\n\t          display:none;\r\n\t        }\r\n\t        .chargeRateList{\r\n\t          width:100%;\r\n\t          margin:0 auto;\r\n\t        }\r\n\t        .chargeRateBtn{\r\n\t          margin:20px 0;\r\n\t          background:#ED6636;\r\n\t        }\r\n\t        .chargeRateWrapper{\r\n\t        \tdisplay: none;\r\n\t        }\r\n\t        #chargeRateList th{\r\n\t        \tpadding: 6px;\r\n\t        }\r\n\t        #chargeRateList td{\r\n\t        \tpadding: 6px;\r\n\t\t\t\ttext-align: center;\r\n\t\t\t\tvertical-align: middle;\r\n\t        }\r\n\t\t</style>\r\n\t</head>\r\n\r\n\t<body ontouchstart>\r\n\t\t<div class=\"main\" style=\"padding: 10px;\">\r\n\t\t\t<div class=\"weui-cells\" style=\"margin-top: 0px;\">\r\n\t\t\t\t<div class=\"cmso\">\r\n\t\t\t\t\t<a href=\"\" id=\"serviceTelephone\"><i class=\"ico ico78\"></i></a>\r\n\t\t\t\t\t<p class=\"cTi\" id=\"deviceName\">设备名称</p>\r\n\t\t\t\t\t<p class=\"cCi\">\r\n\t\t\t\t\t\t<i class=\"ico ico13\"></i><i id=\"siteName\">场地名称</i>\r\n\t\t\t\t\t</p>\r\n\t\t\t\t</div>\r\n\t\t    </div>\r\n\t\t    <div class=\"weui-cells__title\" style=\"margin-top: .3em;\">费率信息</div>\r\n\t\t\t<div class=\"weui-cells\">\r\n\t\t\t\t<div class=\"nbvs mt10\" style=\"padding: 0px;\">\r\n\t\t\t\t\t<ul class=\"clearfix\" id=\"RateUl\">\r\n\t\t\t\t\t\t<li id=\"balanceLi\">\r\n\t\t\t\t\t\t\t<div class=\"nvs\">\r\n\t\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t\t<i id=\"balance\" style=\"font-size: 14px;\"></i>元\r\n\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t\t总余额/可用余额\r\n\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li id=\"chargeRateLi\">\r\n\t\t\t\t\t\t\t<div class=\"nvs\">\r\n\t\t\t\t\t\t\t\t<p><i></i><span>充电费率</span></p>\r\n\t\t\t\t\t\t\t\t<p>(点击查看)</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<!-- <li id=\"storeRateLi\">\r\n\t\t\t\t\t\t\t<div class=\"nvs\">\r\n\t\t\t\t\t\t\t\t<p><i></i><span>仓储费率</span></p>\r\n\t\t\t\t\t\t\t\t<p>(点击查看)</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t -->\r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<div class=\"nvs\">\r\n\t\t\t\t\t\t\t\t<a href=\"acctRechargePage.do?fromPage=dpBoxPage\" class=\"weui-btn\" style=\"background: #ff5f45;font-size:14px;margin: 6px 6px;\">充值</a>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"weui-cells__title\" style=\"margin-top: .3em;\">充电柜列表</div>\r\n\t\t\t<div class=\"weui-cells\">\r\n\t            \t<div class=\"cdfs cdfs2\">\r\n\t\t\t\t\t\t<ul class=\"clearfix\" id=\"channelUl\">\r\n\t\t\t\t\t\t\t<!-- \r\n\t\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t\t<a href=\"javascript:void(0);\" class=\"cur\" channelId=\"1\">通道1<i class=\"ico ico21\"></i></a>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t\t<a href=\"javascript:void(0);\" channelId=\"2\">通道2<i></i> </a>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t\t<a href=\"javascript:void(0);\" channelId=\"3\">通道3<i></i> </a>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t\t<a href=\"javascript:void(0);\" channelId=\"4\">通道4<i></i> </a>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t -->\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</div>\r\n\t        </div>\r\n\t        <div class=\"weui-cells__title\" style=\"margin-top: .3em;\">充电选项</div>\r\n\t\t\t<div class=\"weui-cells\">\r\n\t\t\t\t<div class=\"cdfs cdfs2 csds3\">\r\n\t\t\t\t\t<ul class=\"clearfix\" id=\"payAmountUl\">\r\n\t\t\t\t\t\t<!-- \r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<a class=\"cur\" href=\"javascript:void(0);\" amount=\"1\">1元<i class=\"ico ico21\"></i>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<a href=\"javascript:void(0);\"  amount=\"2\">2元<i></i> </a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<a href=\"javascript:void(0);\"  amount=\"3\">3元<i></i> </a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<a href=\"javascript:void(0);\"  amount=\"5\">5元<i></i> </a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<a href=\"javascript:void(0);\"  amount=\"10\">10元<i></i> </a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li>\r\n\t\t\t\t\t\t\t<a href=\"javascript:void(0);\" amount=\"user_define\">自定义<i></i> </a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t-->\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t</div>\r\n\t\t\t\t<!-- 自定义数量 -->\r\n\t\t\t\t<div id=\"userDefineAmountDiv\" style=\"display: none;\">\r\n\t\t\t\t\t<div class=\"weui-cell\">\r\n\t\t\t\t        <table>\r\n\t\t\t\t\t\t\t<tr style=\"text-align: center;\">\r\n\t\t\t\t\t\t\t\t<td style=\"width: 30%;text-align: center;\">\r\n\t\t\t\t\t\t\t\t\t<input type=\"number\" placeholder=\"请输入\" id=\"totalAmountHour\" style=\"width: 100%;padding-right: 0em; border-style: none;text-align: center;\"/>\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t<td style=\"width: 13%;text-align: center;\">\r\n\t\t\t\t\t\t\t\t\t小时\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t<td style=\"width: 30%;text-align: center;\">\r\n\t\t\t\t\t\t\t\t\t<input type=\"number\" placeholder=\"请输入\" id=\"totalAmountMin\" style=\"width: 100%;padding-right: 0em; border-style: none;text-align: center;\" />\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t<td style=\"width: 13%;text-align: center;\">\r\n\t\t\t\t\t\t\t\t\t分钟\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t</table>\r\n\t\t\t\t    </div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"mui-card\"  style=\"display: none;\">\r\n\t\t        <p style=\"text-align:center;margin-top:10px;\">\r\n\t\t        \t<label style=\"color: #888; font-weight: 700;font-size:14px;\" id=\"rechargeText\"></label><label style=\"color: red;\"> (按照最小功率费率估算)</label>\r\n\t\t        \t<input style=\"display:none;\" id=\"totalFee\" type=\"text\"/>\r\n\t\t        </p>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"weui-cells\"style=\"display: none; margin-top: 8px\" id=\"selfCombustionDivFather\">\r\n\t\t\t\t<div class=\"safeServiceDiv1\" style=\"padding: 5px 15px 0px 15px;position: relative;\">\r\n\t\t\t\t\t<h3 id=\"selfCombustionTitle\" style=\"height: 25px;font-size: 16px\" ><img src=\"img/product.png\" style=\"width: 21px;height: 21px\">安心充无忧服务</h3>\r\n\t\t\t\t\t<span style=\"font-size: 10px; position: absolute; bottom: 1px; margin-left: 135px; color: #D29562;\">（ 充电过程中自燃最高可享5000元补偿金！）</span>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"cdfs cdfs2\" id=\"selfCombustionDiv\">\r\n\t\t\t\t\t<ul class=\"clearfix\" >\r\n\t\t\t\t\t\t<li><a href='javascript:void(0);' id=\"aDay\" data-value=\"1\" onclick=\"choiceSelfCombustion(0)\">\r\n\t\t\t\t\t\t\t<p class=\"selfCombustionStyle0 \">单次</p>\r\n\t\t\t\t\t\t\t<p class=\"selfCombustionStyle0 \">￥0.09</p>\r\n\t\t\t\t\t\t\t<p class=\"styled-i\">仅限单次充电</p>\r\n\t\t\t\t\t\t\t<i id=\"iDay\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li><a href='javascript:void(0);'  id=\"aMonth\" data-value=\"2\"  onclick=\"choiceSelfCombustion(1)\">\r\n\t\t\t\t\t\t\t<p class=\"selfCombustionStyle1\">30天</p>\r\n\t\t\t\t\t\t\t<p class=\"selfCombustionStyle1\"> ￥1.99</p>\r\n\t\t\t\t\t\t\t<p class=\"styled-i\">30天不限次数</p>\r\n\t\t\t\t\t\t\t<i id=\"iMonth\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li><a href='javascript:void(0);' id=\"aYear\" data-value=\"3\" onclick=\"choiceSelfCombustion(2)\">\r\n\t\t\t\t\t\t\t<p class=\"selfCombustionStyle2\">365天</p>\r\n\t\t\t\t\t\t\t<p class=\"selfCombustionStyle2\">￥12.8</p>\r\n\t\t\t\t\t\t\t<p class=\"styled-i\">365天内不限次数</p>\r\n\t\t\t\t\t\t\t<i id=\"iYear\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"safeServiceDiv\" style=\"display: none;\" id=\"safaProductDiv\">\r\n\t\t\t\t<div class=\"safeServiceDiv1\">\r\n\t\t\t\t\t<h3 class=\"safeServiceH1\"><img src=\"img/product.png\">安心充无忧服务 <img style=\"padding-left:4px\" onclick=\"toInsurance()\" src=\"img/what.png\"></h3>\r\n\t\t\t\t\t<h3 class=\"safeServiceH2\">防护开启中</h3>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"safeServiceDiv2\">\r\n\t\t\t\t\t<p class=\"safeServiceP1\">过程中自燃最高可享5000元补偿金！</p>\r\n\t\t\t\t\t<p class=\"safeServiceP2\">剩余防护天数：<span style=\"color: red\" id=\"safeServiceDay\"></span></p>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"weui-cells__title\" >支付方式选择</div>\r\n\t\t\t<div class=\"weui-cells\" >\r\n\t\t\t\t<div class=\"cdfs cdfs2 csds3\">\r\n\t\t\t\t\t<ul class=\"clearfix\" id=\"payTypeUl\">\r\n\t\t\t\t\t\t<li id=\"vipCardBox\" for=\"in\" style=\"width: 40%\">\r\n\t\t\t\t\t\t\t<a class=\"cur\" for=\"in\" href=\"javascript:void(0);\" payType=\"acct\" style=\"margin-top: 4%;\" >\r\n\t\t\t\t\t\t\t\t<input class=\"weui-input\" id=\"in\" type=\"text\" value=\"\" readonly  typeId =\"\" style=\"text-align: center\" >\r\n\t\t\t\t\t\t\t\t<i class=\"ico ico21\"></i>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t<li id=\"acctPayBtn\">\r\n\t\t\t\t\t\t\t<a class=\"cur\" id=\"acctPay\" href=\"javascript:void(0);\" payType=\"acct\" >账户支付\r\n\t\t\t\t\t\t\t\t<input type=\"text\" style=\"display: none\" data-values=\"0\">\r\n\t\t\t\t\t\t\t\t<i class=\"ico ico21\"></i>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<!-- 启动充电按钮 -->\r\n\t\t\t<div class=\"button-container\">\r\n\t\t\t\t<button class=\"start-charging-btn\" id=\"startChargeBtn\"><p style=\"font-weight: bold;font-size: 16px\">普通充电</p></button>\r\n\t\t\t\t<button class=\"worry-free-charging-btn\" id=\"chargeBtnByInsurance\" style=\"display: none\" onclick=\"startChargeBtnByInsurance()\"><p style=\"font-weight: bold;font-size: 16px\">无忧充电</p><p  style=\"font-size: 9px\">无忧充电服务费加0.09元/次</p></button>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"weui-cells\" style=\"margin-bottom: 15px\">\r\n\t\t\t\t<label for=\"autoStopFlag\" class=\"weui-agree\">\r\n\t\t\t\t\t<span class=\"weui-agree__text\" style=\"color: #888; font-weight: 700;\">充满自动断电</span>\r\n\t\t\t\t\t<input id=\"autoStopFlag\" type=\"checkbox\" class=\"weui-agree__checkbox\"checked=\"checked\"/>\r\n\t\t\t\t</label>\r\n\t\t\t\t<label class=\"weui-agree\">\r\n\t\t\t\t\t<i class=\"weui-icon-warn\" style=\"font-size: 14px;\"></i>\r\n\t\t\t\t\t<span class=\"weui-agree__text\" style=\"font-size: 10px;\">如在充电过程中有充不满就停止的情况，请去掉此选项</span>\r\n\t\t\t\t</label>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"mui-card\" align=\"center\" style=\"border: 0px  #222222; height: 15%;\">\r\n\t\t\t\t<a  style=\"width: 100%;\" href=\"toSelectVipCardTypePage.do\">\r\n\t\t\t\t\t<img src=\"img/advertising.JPG\" style=\"transform: scale(0.92)\"/> </a>\r\n\t\t\t</div>\r\n\t\t\t<label class=\"weui-agree\" style=\"text-align: center;\">\r\n\t\t        <i class=\"weui-icon-warn\" style=\"font-size: 14px;\"></i>\r\n\t\t        <span class=\"weui-agree__text\">\r\n\t\t          <a href=\"https://jiandaoyun.com/f/5b8df4c3c67c3f34ec0cb563\" style='pointer-events:auto;'>故障反馈</a>\r\n\t\t        </span>\r\n\t      \t</label>\r\n\t      \t<!-- 阴影层 -->\r\n\t      \t<div class=\"weui-mask weui-mask--visible chargeRateWrapper\" id=\"chargeWrapper\"></div>\r\n\t      \t<div class='chargeRateMode chargeRateWrapper' onclick=\"colseChargeRateWrapper()\">\r\n\t        \t<div class='chargeRateTitle'>充电收费标准</div>\r\n\t        \t<div class='chargeRateList' id=\"chargeRateList\">\r\n\t          \r\n\t        \t</div>\r\n\t        \t<div class='chargeRateTitle'>仓储收费标准</div>\r\n\t        \t<div class='chargeRateList'>\r\n\t          \t\t<table border='1'>\r\n\t                 \t<thead><tr><th>起止时间</th><th>金额(元)</th><th>时间(分)</th> </tr></thead>\r\n\t                 \t<tbody id='storeRateList'>\r\n\t                     \r\n\t                 \t</tbody>\r\n\t             \t</table> \r\n\t        \t</div>\r\n\t        \t<button class=\"weui-btn weui-btn_primary chargeRateBtn\" onclick=\"colseChargeRateWrapper()\">确定</button>\r\n\t      \t</div>\r\n\t\t\t<!-- 阴影层 -->\r\n\t\t\t<div class=\"weui-mask\"id=\"selfCombustionServiceVisible\"></div>\r\n\t\t\t<div class='selfCombustionService selfCombustionWrapper'>\r\n\t\t\t\t<div style=\"width: 100%; height: 28px;\">\r\n\t\t\t\t\t<h2 style=\"margin-top: 3px\">安心充无忧服务使用协议</h2>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"textWrapper\">\r\n\t\t\t\t\t<p class=\"serviceText\">尊敬的用户，感谢您使用本充电平台并选择订购安心充无忧服务。为保障您的合法权益，请您仔细阅读本协议：</p>\r\n\t\t\t\t\t<p class=\"serviceText\">安心充无忧服务是本平台为用户提供的一项充电过程中实时防护的有偿增值服务，费用为0.09元/次。\r\n\t\t\t\t\t\t安心充无忧服务是通过平台研发的智能充电安全防护技术，对充电全过程中的电压、电流、功率、环境温度进行实时动态监测，\r\n\t\t\t\t\t\t当系统监测到异常时，将开启主动干预充电保护，对车辆进行断电/停充等保护措施，并给您发送消息提醒。</p>\r\n\t\t\t\t\t<p class=\"serviceText\">特别提醒：为便于您后续充电时订购使用安心充无忧服务，您在同意本协议后，本平台将为您后续的每次充电订单提供安心充无忧服务。\r\n\t\t\t\t\t\t如您后续无需订购安心充无忧服务，您可以随时在充电页面取消。取消后，您将不再享受安心充无忧服务。\r\n\t\t\t\t\t\t本协议系《安心充无忧服务使用协议》的有效组成部分，请您充分阅读并理解上述协议，点击同意按钮即表示您已同意上述协议。</p>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"bottomDiv\" >\r\n\t\t\t\t\t<div class=\"bottomP\">\r\n\t\t\t\t\t\t<p>您可以查看完整<a href='javascript:void(0);' onclick=\"toInsurance()\">《安心充无忧服务使用协议》</a></p>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"serviceBtnDiv\">\r\n\t\t\t\t\t\t<button class=\"serviceBtn1\"  onclick=\"confirmServiceByOnce()\">单次开通</button>\r\n\t\t\t\t\t\t<button  class=\"serviceBtn2\" onclick=\"confirmService()\">同意并长期开通</button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<!-- 阴影层 -->\r\n\t\t\t<div class=\"weui-mask\" id=\"confirmButDivWrapper\"></div>\r\n\t\t\t<div class='confirmButDiv confirmButDivWrapper'>\r\n\t\t\t\t<div class=\"confirmButTextWrapper\">\r\n\t\t\t\t\t<p class=\"serviceText\">\r\n\t\t\t\t\t\t您已经勾选了安心充无忧服务选项,推荐您选择无忧充电！\r\n\t\t\t\t\t\t注意：如果选择普通充电，将不再享受安心充无忧服务。\r\n\t\t\t\t\t</p>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"bottomDiv\" style=\"height: 60px\" >\r\n\t\t\t\t\t<div class=\"button-container\">\r\n\t\t\t\t\t\t<button class=\"start-charging-btn\" onclick=\"clearMarkSubmit()\" ><p style=\"font-weight: bold;font-size: 16px\">普通充电</p></button>\r\n\t\t\t\t\t\t<button class=\"worry-free-charging-btn\" onclick=\"startChargeBtnByInsurance()\"  ><p style=\"font-weight: bold;font-size: 16px\">无忧充电</p></button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</body>\r\n\t<script type=\"text/javascript\" src=\"js/jquery-1.10.2.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"js/jquery-weui.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"js/common.js\"></script>\r\n\r\n\t<script>\r\n\t\t//是否取消充电安全无忧服务标志\r\n\t\tvar serviceType=\"temp\";\r\n\t\t//是否长期开通单次服务标志(默认不开通)\r\n\t\tvar singleMark=0;\r\n\t\t//防护是否开启\r\n\t\tvar selfCombustionPro=false;\r\n\t\t//防护天数\r\n\t\tvar dayPro=0;\r\n\t\t//运营商开通安心充服务\r\n\t\tvar singleInsurance=false;\r\n\t\t// 点击弹窗外部区域关闭弹窗\r\n\t\twindow.onclick = function(event) {\r\n\t\t\tif (event.target == document.getElementById(\"selfCombustionServiceVisible\")) {\r\n\t\t\t\t$(\"#selfCombustionServiceVisible\").removeClass(\"weui-mask--visible\");\r\n\t\t\t\t$('.selfCombustionWrapper').hide();\r\n\t\t\t}\r\n\t\t\tif (event.target == document.getElementById(\"confirmButDivWrapper\")) {\r\n\t\t\t\t$(\"#confirmButDivWrapper\").removeClass(\"weui-mask--visible\");\r\n\t\t\t\t$('.confirmButDivWrapper').hide();\r\n\t\t\t}\r\n\t\t\tif (event.target == document.getElementById(\"chargeWrapper\")) {\r\n\t\t\t\t$(\"#chargeWrapper\").removeClass(\"weui-mask--visible\");\r\n\t\t\t\t$('.chargeRateWrapper').hide();\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t//跳转完整协议\r\n\t\tfunction toInsurance(){\r\n\t\t\twindow.location.href=\"toInsurance.do\";\r\n\t\t}\r\n\r\n\t\t$('#vipCardBox').on('click', function() {\r\n\t\t\t$(\"#selfCombustionTitle\").hide();\r\n\t\t\t$(\"#selfCombustionDivFather\").hide();\r\n\t\t\t$(\"#chargeBtnByInsurance\").hide();\r\n\t\t});\r\n\r\n\t\t$('#acctPayBtn').on('click', function() {\r\n\t\t\tif (singleInsurance){\r\n\t\t\t\tif (selfCombustionPro&&dayPro>=0){\r\n\t\t\t\t\tvar text=dayPro+'天';\r\n\t\t\t\t\t$(\"#safeServiceDay\").text(text);\r\n\t\t\t\t\t$(\"#safaProductDiv\").show();\r\n\t\t\t\t\t$(\"#chargeBtnByInsurance\").hide();\r\n\t\t\t\t\t// 清除内容并替换为 \"无忧充电\"\r\n\t\t\t\t\t$('#startChargeBtn').html('<p style=\"font-weight: bold; font-size: 16px\">无忧充电</p>');\r\n\t\t\t\t\t// 更改按钮的类\r\n\t\t\t\t\t$('#startChargeBtn').removeClass('start-charging-btn').addClass('worry-free-charging-btn');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif (singleMark==1){\r\n\t\t\t\t\t\tif ($('#selfCombustionDiv').find('.cur').length > 0) {\r\n\t\t\t\t\t\t\t$(\"#selfCombustionTitle\").show();\r\n\t\t\t\t\t\t\t$(\"#selfCombustionDivFather\").show();\r\n\t\t\t\t\t\t\t$(\"#chargeBtnByInsurance\").show();\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t$(\"#aDay\").addClass(\"cur\")\r\n\t\t\t\t\t\t\t$(\"#iDay\").addClass(\"ico ico21\")\r\n\t\t\t\t\t\t\t$(\".selfCombustionStyle0\").addClass(\"choiceColor\")\r\n\t\t\t\t\t\t\t$(\"#selfCombustionTitle\").show();\r\n\t\t\t\t\t\t\t$(\"#selfCombustionDivFather\").show();\r\n\t\t\t\t\t\t\t$(\"#chargeBtnByInsurance\").show();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(\"#aDay\").removeClass(\"cur\")\r\n\t\t\t\t\t\t$(\"#iDay\").removeClass(\"ico ico21\")\r\n\t\t\t\t\t\t$(\".selfCombustionStyle0\").removeClass(\"choiceColor\")\r\n\t\t\t\t\t\t$(\"#selfCombustionTitle\").show();\r\n\t\t\t\t\t\t$(\"#selfCombustionDivFather\").show();\r\n\t\t\t\t\t\t$(\"#chargeBtnByInsurance\").show();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\r\n\t\t//点击单次开通防护按钮\r\n\t\tfunction confirmServiceByOnce(){\r\n\t\t\t//设置选择标志\r\n\t\t\tserviceType=0;\r\n\t\t\t$(\"#aDay\").addClass(\"cur\");\r\n\t\t\t$(\"#iDay\").addClass(\"ico ico21\")\r\n\t\t\t$(\"#aMonth\").removeClass(\"cur\")\r\n\t\t\t$(\"#iMonth\").removeClass(\"ico ico21\")\r\n\t\t\t$(\"#aYear\").removeClass(\"cur\")\r\n\t\t\t$(\"#iYear\").removeClass(\"ico ico21\")\r\n\t\t\t$(\".selfCombustionStyle0\").addClass(\"choiceColor\")\r\n\t\t\t$(\".selfCombustionStyle1\").removeClass(\"choiceColor\")\r\n\t\t\t$(\".selfCombustionStyle2\").removeClass(\"choiceColor\")\r\n\t\t\t$(\"#selfCombustionServiceVisible\").removeClass(\"weui-mask--visible\");\r\n\t\t\t$('.selfCombustionWrapper').hide();\r\n\t\t}\r\n\r\n\t\t//长期开通防护按钮\r\n\t\tfunction confirmService(){\r\n\t\t\tsingleMark=1;\r\n\t\t\tserviceType=0;\r\n\t\t\t$(\"#aDay\").addClass(\"cur\");\r\n\t\t\t$(\"#iDay\").addClass(\"ico ico21\")\r\n\t\t\t$(\"#aMonth\").removeClass(\"cur\")\r\n\t\t\t$(\"#iMonth\").removeClass(\"ico ico21\")\r\n\t\t\t$(\"#aYear\").removeClass(\"cur\")\r\n\t\t\t$(\"#iYear\").removeClass(\"ico ico21\")\r\n\t\t\t$(\".selfCombustionStyle0\").addClass(\"choiceColor\")\r\n\t\t\t$(\".selfCombustionStyle1\").removeClass(\"choiceColor\")\r\n\t\t\t$(\".selfCombustionStyle2\").removeClass(\"choiceColor\")\r\n\t\t\t$(\"#selfCombustionServiceVisible\").removeClass(\"weui-mask--visible\");\r\n\t\t\t$('.selfCombustionWrapper').hide();\r\n\t\t}\r\n\r\n\t\t//页面加载启动后台检测\r\n\t\tfunction checkInsuranceDetail(defaultPayType){\r\n\t\t\t//获取当前时间\r\n\t\t\tvar currentTime = getCurrentTime();\r\n\t\t\t$.ajax({\r\n\t\t\t\turl : \"checkInsuranceDetail.do\",\r\n\t\t\t\tdata : {\r\n\t\t\t\t\t\"currentTime\" : currentTime\r\n\t\t\t\t},\r\n\t\t\t\ttimeout : 20000,\r\n\t\t\t\ttype : \"get\",\r\n\t\t\t\tasync : true,\r\n\t\t\t\tdataType : \"json\",\r\n\t\t\t\tsuccess : function(res) {\r\n\t\t\t\t\tconsole.log(res.returnCode)\r\n\t\t\t\t\tif(res.returnCode == \"OUTOFDATE\"){\r\n\t\t\t\t\t\tcolseChargeRateWrapper();\r\n\t\t\t\t\t\t$.alert(\"网页已过期\",\"提示\",function(){WeixinJSBridge.call('closeWindow');});\r\n\t\t\t\t\t}else if (res.returnCode==\"05\"){\r\n\t\t\t\t\t\tselfCombustionPro=true;\r\n\t\t\t\t\t\tdayPro=res.result;\r\n\t\t\t\t\t\t//开通  显示防护公告 更改按钮样式\r\n\t\t\t\t\t\tvar text=res.result+'天';\r\n\t\t\t\t\t\t$(\"#safeServiceDay\").text(text);\r\n\t\t\t\t\t\t$(\"#safaProductDiv\").show();\r\n\t\t\t\t\t\t$(\"#chargeBtnByInsurance\").hide();\r\n\t\t\t\t\t\t// 清除内容并替换为 \"无忧充电\"\r\n\t\t\t\t\t\t$('#startChargeBtn').html('<p style=\"font-weight: bold; font-size: 16px\">无忧充电</p>');\r\n\t\t\t\t\t\t// 更改按钮的类\r\n\t\t\t\t\t\t$('#startChargeBtn').removeClass('start-charging-btn').addClass('worry-free-charging-btn');\r\n\r\n\t\t\t\t\t}else if (res.returnCode==\"03\") {\r\n\t\t\t\t\t\tsingleInsurance=true;\r\n\t\t\t\t\t\tif(defaultPayType!=\"vip\"){\r\n\t\t\t\t\t\t\t//未开通\r\n\t\t\t\t\t\t\t$(\"#selfCombustionTitle\").show();\r\n\t\t\t\t\t\t\t$(\"#selfCombustionDivFather\").show();\r\n\t\t\t\t\t\t\t$(\"#chargeBtnByInsurance\").show();\r\n\t\t\t\t\t\t\t$(\"#aDay\").removeClass(\"cur\")\r\n\t\t\t\t\t\t\t$(\"#iDay\").removeClass(\"ico ico21\")\r\n\t\t\t\t\t\t\t$(\".selfCombustionStyle0\").removeClass(\"choiceColor\")\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(res.returnCode==\"04\"){\r\n\t\t\t\t\t\tsingleInsurance=true;\r\n\t\t\t\t\t\tif (defaultPayType==\"vip\"){\r\n\t\t\t\t\t\t\tserviceType=0;\r\n\t\t\t\t\t\t\tsingleMark=1;\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t//未开通 但是长期开通勾选\r\n\t\t\t\t\t\t\t$(\"#selfCombustionTitle\").show();\r\n\t\t\t\t\t\t\t$(\"#selfCombustionDivFather\").show();\r\n\t\t\t\t\t\t\t$(\"#chargeBtnByInsurance\").show();\r\n\t\t\t\t\t\t\t$(\"#aDay\").addClass(\"cur\")\r\n\t\t\t\t\t\t\t$(\"#iDay\").addClass(\"ico ico21\")\r\n\t\t\t\t\t\t\t$(\".selfCombustionStyle0\").addClass(\"choiceColor\")\r\n\t\t\t\t\t\t\tserviceType=0;\r\n\t\t\t\t\t\t\tsingleMark=1;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//不支持安心充服务（1.未开通自助退款 2、会员卡  3、关闭安心充服务） 不做处理\r\n\t\t\t\t\t}\r\n\t\t\t\t},\r\n\t\t\t\tcomplete:function(){\r\n\t\t\t\t\t//隐藏加载等待提示框\r\n\t\t\t\t\t$.hideLoading();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\t//获取当前时间\r\n\t\tfunction getCurrentTime() {\r\n\t\t\tconst now = new Date();\r\n\t\t\tconst year = now.getFullYear();\r\n\t\t\tconst month = String(now.getMonth() + 1).padStart(2, '0'); // 月份从0开始\r\n\t\t\tconst day = String(now.getDate()).padStart(2, '0');\r\n\t\t\tconst hours = String(now.getHours()).padStart(2, '0');\r\n\t\t\tconst minutes = String(now.getMinutes()).padStart(2, '0');\r\n\t\t\tconst seconds = String(now.getSeconds()).padStart(2, '0');\r\n\t\t\treturn year + '-' + month + '-' + day + ' ' + hours + ':' + minutes + ':' + seconds;\r\n\t\t}\r\n\r\n\t\t//打开同意书\r\n\t\tfunction openServiceDoc(){\r\n\t\t\t$(\"#selfCombustionServiceVisible\").addClass(\"weui-mask--visible\");\r\n\t\t\t$(\".selfCombustionWrapper\").show();\r\n\t\t}\r\n\r\n\t\t//取消充电安全无忧服务\r\n\t\tfunction cancelService(){\r\n\t\t\tvar result = confirm(\"您确认要取消安心充无忧服务吗？\");\r\n\t\t\tif (result){\r\n\t\t\t\t$(\"#aDay\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iDay\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\"#aMonth\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iMonth\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\"#aYear\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iYear\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\".selfCombustionStyle1\").removeClass(\"choiceColor\")\r\n\t\t\t\t$(\".selfCombustionStyle2\").removeClass(\"choiceColor\")\r\n\t\t\t\t$(\".selfCombustionStyle0\").removeClass(\"choiceColor\")\r\n\t\t\t\tserviceType=\"temp\"\r\n\t\t\t\tsingleMark=0;\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t\t//安全服务选择\r\n\t\tfunction choiceSelfCombustion(data){\r\n\t\t\tif (data==serviceType){\r\n\t\t\t\t//两次点击同一个选项，执行取消按钮\r\n\t\t\t\tcancelService();\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tif (data==0){\r\n\t\t\t\topenServiceDoc()\r\n\t\t\t}else if(data==1){\r\n\t\t\t\tserviceType=1;\r\n\t\t\t\t$(\"#aMonth\").addClass(\"cur\");\r\n\t\t\t\t$(\"#iMonth\").addClass(\"ico ico21\")\r\n\t\t\t\t$(\"#aDay\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iDay\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\"#aYear\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iYear\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\".selfCombustionStyle1\").addClass(\"choiceColor\")\r\n\t\t\t\t$(\".selfCombustionStyle0\").removeClass(\"choiceColor\")\r\n\t\t\t\t$(\".selfCombustionStyle2\").removeClass(\"choiceColor\")\r\n\t\t\t}else{\r\n\t\t\t\tserviceType=2;\r\n\t\t\t\t$(\"#aYear\").addClass(\"cur\");\r\n\t\t\t\t$(\"#iYear\").addClass(\"ico ico21\")\r\n\t\t\t\t$(\"#aMonth\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iMonth\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\"#aDay\").removeClass(\"cur\")\r\n\t\t\t\t$(\"#iDay\").removeClass(\"ico ico21\")\r\n\t\t\t\t$(\".selfCombustionStyle2\").addClass(\"choiceColor\")\r\n\t\t\t\t$(\".selfCombustionStyle1\").removeClass(\"choiceColor\")\r\n\t\t\t\t$(\".selfCombustionStyle0\").removeClass(\"choiceColor\")\r\n\t\t\t}\r\n\t\t}\r\n\t</script>\r\n\t<script type=\"text/javascript\">\r\n\t\t//openId\r\n\t\tvar openId;\r\n\t\t//设备信息\r\n\t\tvar details\r\n\t\t//最小单位扣款金额（元）\r\n\t\tvar unitAmount = 0;\r\n\t\t//最小扣款单位时长（分钟）\r\n\t\tvar unitDeduct = 1;\r\n\t\t// 进入页面显示费率\r\n\t\tvar stepRate;\r\n\t\t// 最后一项显示为充满自停\r\n\t\tvar fullStop = \"on\";\r\n\t\t$(function () {\r\n\t\t\topenId = \"ozCzC0rndHT4XFv9wCFR7U5GuU8E\";\r\n\t\t\tdetails = {\"customWord\":1,\"GID\":\"FFFF000102117180\",\"fullStop\":\"on\",\"chargeType\":2,\"siteName\":\"默认场地\",\"acctRecharge\":true,\"deviceName\":\"国防科技园1号机\",\"userId\":6021957,\"chargeOption\":\"2-4-6-8-10\",\"channelMap\":{\"1\":{\"channelStatus\":\"O\",\"chargedQuantity\":0.0,\"chargedTime\":120.0,\"chargeI\":0,\"chargeU\":0,\"userId\":6016701,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791434006413},\"2\":{\"channelStatus\":\"O\",\"chargedQuantity\":0.0,\"chargedTime\":192.13,\"chargeI\":0,\"chargeU\":0,\"userId\":6505851,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791453617060},\"3\":{\"channelStatus\":\"C\",\"chargedQuantity\":0.0,\"chargedTime\":108.73,\"chargeI\":0,\"chargeU\":0,\"userId\":6234118,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791472082380},\"4\":{\"channelStatus\":\"O\",\"chargedQuantity\":0.0,\"chargedTime\":120.0,\"chargeI\":0,\"chargeU\":0,\"userId\":6336249,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791425476654},\"5\":{\"channelStatus\":\"O\",\"chargedQuantity\":0.0,\"chargedTime\":418.67,\"chargeI\":0,\"chargeU\":0,\"userId\":6537525,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791440112477},\"6\":{\"channelStatus\":\"O\",\"chargedQuantity\":0.0,\"chargedTime\":270.23,\"chargeI\":0,\"chargeU\":0,\"userId\":6203621,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791458752756},\"7\":{\"channelStatus\":\"I\",\"chargedQuantity\":0.0,\"chargedTime\":360.52,\"chargeI\":0,\"chargeU\":0,\"userId\":6059544,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791421819050},\"8\":{\"channelStatus\":\"O\",\"chargedQuantity\":0.0,\"chargedTime\":313.72,\"chargeI\":0,\"chargeU\":0,\"userId\":6728311,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1791430543054},\"9\":{\"channelStatus\":\"I\",\"chargedQuantity\":0.0,\"chargedTime\":206.5,\"chargeI\":0,\"chargeU\":0,\"userId\":5700859,\"payAmount\":-1.0,\"resultCode\":0,\"resultMsg\":\"SUC\",\"startChargeTime\":1790931413241}},\"returnCode\":\"0\",\"prepay\":false,\"defaultChargeOption\":5,\"balance\":2.24,\"regionId\":7778,\"rateList\":[{\"stepId\":538658,\"deviceId\":46388,\"stepType\":\"CHARGE\",\"power\":600,\"unitTime\":60,\"unitAmount\":0.43,\"operatorId\":103745},{\"stepId\":538659,\"deviceId\":46388,\"stepType\":\"STORE\",\"beginTime\":\"00:00\",\"endTime\":\"00:00\",\"unitTime\":60,\"unitAmount\":0.0,\"operatorId\":103745}],\"lockBalance\":0.0,\"deviceModel\":\"02\",\"operatorId\":103745,\"merchantNo\":\"\"};\r\n\t\t\tstepRate = \"1\";\r\n\t\t\t$.showLoading();\r\n\t\t\t// 判断进入页面是否显示费率信息\r\n\t\t\tif (stepRate == 1) {\r\n\t\t\t\t$('.chargeRateWrapper').show();\r\n\t\t\t}\r\n\t\t\t//设置显示页面信息\r\n\t\t\tsetPageInfo(details);\r\n\t\t\t//初始化充电选项\r\n\t\t\tinitRechargeChoice(details);\r\n\t\t\t//进入页面显示费率信息\r\n\t\t\t//判断用户在当前设备上是否有正在充电信息\r\n\t\t\tvar chargeFlowNo = details.chargeFlowNo;\r\n\t\t\tif (chargeFlowNo != null && chargeFlowNo != undefined) {\r\n\t\t\t\t//设置显示有正在充电提示框\r\n\t\t\t\t$.confirm(\"已有正在使用充电柜,是否进入状态页面？\", \"\", function () {\r\n\t\t\t\t\t//确认操作，跳转至充电状态页面\r\n\t\t\t\t\twindow.location.href = \"dpBoxChargeStatusPage.do?chargeFlowNo=\" + chargeFlowNo;\r\n\t\t\t\t}, function () {\r\n\t\t\t\t\t//取消操作，关闭对话框\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t\t// 获取客服电话\r\n\t\t\t$.ajax({\r\n\t\t\t\ttype: 'post',\r\n\t\t\t\turl: 'getServiceTelphone.do',\r\n\t\t\t\tdataType: 'json',\r\n\t\t\t\tsuccess: function(res) {\r\n\t\t\t\t\tif (res.servicerTelphone !== undefined) {\r\n\t\t\t\t\t\t$(\"#serviceTelephone\").attr('href','tel:'+res.servicerTelphone);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t})\r\n\t\t//定义数组作为select选项\r\n\t\tvar selectItems = [];\r\n\t\t// 下拉框配置\r\n\t\tvar selectConfig = {\r\n\t\t\ttitle: \"支付方式\",\r\n\t\t\titems: selectItems,\r\n\t\t\tmin: 1,\r\n\t\t\tmax: 1,\r\n\t\t\tbeforeClose: function (values, titles) {\r\n\t\t\t},\r\n\t\t\tonChange: function (data) {\r\n\t\t\t},\r\n\t\t\tonClose: function (data) {\r\n\t\t\t}\r\n\t\t};\r\n\t\t// 获取用户有效会员卡信息\r\n\t\tvar res = {\"returnCode\": \"200\",\"vipCardList\":[]};\r\n\t\t//遍历获取单个会员卡信息，组成weui 下拉框需要的格式\r\n\t\tfor (var i = 0; i < res.vipCardList.length; i++) {\r\n\t\t\tvar option = {\r\n\t\t\t\t\"title\": i + parseInt(1) + \".\" + res.vipCardList[i].typeName,\r\n\t\t\t\t\"value\": res.vipCardList[i].cardId\r\n\t\t\t};\r\n\t\t\tselectItems.push(option);\r\n\t\t}\r\n\t\t// 初始化下拉框\r\n\t\t$(\"#in\").select(selectConfig);\r\n\t\t//  如果用户持有有效会员卡，默认选中第一张\r\n\t\tif (res.vipCardList.length > 0) {\r\n\t\t\t$(\"#in\").attr(\"value\", \"1.\" + res.vipCardList[0].typeName);\r\n\t\t\t$(\"#in\").attr(\"data-values\", res.vipCardList[0].cardId);\r\n\t\t\t$(\"#acctPayBtn a\").removeClass(\"cur\");\r\n\t\t\t$(\"#acctPayBtn i\").removeClass(\"ico\").removeClass(\"ico21\");\r\n\t\t\tcheckInsuranceDetail(\"vip\");\r\n\t\t} else { // 否则默认选中账户支付\r\n\t\t\tcheckInsuranceDetail(\"acctPayBtn\");\r\n\t\t\t//隐藏会员卡\r\n\t\t\t$(\"#vipCardBox\").hide();\r\n\t\t\t$(\"#vipCardBox a\").removeClass(\"cur\");\r\n\t\t\t$(\"#vipCardBox i\").removeClass(\"ico\").removeClass(\"ico21\");\r\n\t\t}\r\n\r\n\t\t//设置显示通道信息\r\n\t\tfunction setPageInfo(data){\r\n\t\t\t//设置场地名称\r\n\t\t\t$(\"#siteName\").html(data.siteName);\r\n\t\t\t//设置设备名称\r\n\t\t\t$(\"#deviceName\").html(data.deviceName);\r\n\t\t\t//余额/可用余额\r\n\t\t\t$(\"#balance\").html(data.balance.toFixed(2)+\"/\"+(data.balance-data.lockBalance).toFixed(2));\r\n\t\t\tif(data.channelMap == undefined||data.channelMap.length==0){\r\n\t\t\t\t$.alert(\"没有可用的通道\",\"提示\",function(){WeixinJSBridge.call('closeWindow');});\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t//获取channelUl DOM对象\r\n\t\t\tvar channelUl = $(\"#channelUl\");\r\n\t\t\t//是否可默认选中标识\r\n\t\t\tvar channelSelected = true;\r\n\t\t\t//遍历channel信息生产channelHTML\r\n\t\t\tfor (var key in data.channelMap) { \r\n\t\t\t\t//当前通道DOM\r\n\t\t\t\tvar channelItem;\r\n\t\t\t\t//判断是否空闲（D未启用、E启用/未知、I空闲、C充电中、P启动中、F通讯故障、O占用、B设备故障）\r\n\t\t\t\tif(data.channelMap[key].channelStatus == \"I\"){\r\n\t\t\t\t\tif(channelSelected){\r\n\t\t\t\t\t\t//I空闲：默认选中\r\n\t\t\t\t\t\tchannelItem = $(\"<li><a href='javascript:void(0);' class='cur usable' channelId='\"+key+\"' style='color:green;'><p>通道 \"+key+\"</p><p>空闲</p><i class='ico ico21'></i></a></li>\");\r\n\t\t\t\t\t\tchannelSelected=false;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//I空闲\r\n\t\t\t\t\t\tchannelItem = $(\"<li><a href='javascript:void(0);' channelId='\"+key+\"' style='color:green;' class='usable'><p>通道 \"+key+\"</p><p>空闲</p><i></i></a></li>\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\t//状态码\r\n\t\t\t\t\tvar channelCode = data.channelMap[key].channelStatus;\r\n\t\t\t\t\t//状态描述\r\n\t\t\t\t\tvar channelStatus = \"未知\";\r\n\t\t\t\t\tif(channelCode == \"D\"){\r\n\t\t\t        \t//D未启用\r\n\t\t\t        \tchannelStatus=\"未启 用\";\r\n\t\t\t\t\t}else if(channelCode == \"C\"||channelCode == \"O\"||channelCode==\"P\"){\r\n\t\t\t\t\t\t//C充电中P启动中O占用\r\n\t\t\t\t\t\tchannelStatus=\"使用中\";\r\n\t\t\t\t\t}else if(channelCode == \"B\"){\r\n\t\t\t\t\t\t//B故障\r\n\t\t\t\t\t\tchannelStatus=\"故障\";\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tchannelStatus=\"未知\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\tchannelItem = $(\"<li><a href='javascript:void(0);' channelId='\"+key+\"' style='color:#f1c232;' class='unusable'><p>通道 \"+key+\"</p><p>\"+channelStatus+\"</p><i></i></a></li>\");\r\n\t\t\t\t}\r\n\t\t\t\t//添加到通道列表\r\n\t\t        channelItem.appendTo(channelUl);              \r\n          \t}\r\n\t\t}\r\n\r\n\t\t//初始化充电选项\r\n\t\tfunction initRechargeChoice(data){\r\n\t\t\tvar chargeOption = new Array();\r\n\t\t\tvar defaultOption;\r\n\t\t\tif ( data.chargeOption != undefined && data.chargeOption != null && data.chargeOption != \"\" ) {\r\n\t\t\t\tchargeOption = data.chargeOption.split('-');\r\n\t\t\t\tdefaultOption = data.defaultChargeOption;\r\n\t\t\t}\r\n\t\t\tlet dpSettleParam = data.dpSettleParam;\r\n\t\t\tlet rateList = data.rateList;\r\n\t\t\tif(dpSettleParam==null){//计时模式\r\n\t\t\t\tif(rateList.length>0){\r\n\t\t\t\t\tlet rateHtml = \"<table border='1'><thead><tr><th>功率(W)</th><th>金额(元)</th><th>时间(分)</th></tr></thead><tbody>\";\r\n\t\t\t        for (var i = 0; i < rateList.length; i++) {\r\n\t\t\t        \tif(rateList[i].stepType==\"CHARGE\"){\r\n\t\t\t\t            //功率费率,设置功率对应的费率信息----------lxd\r\n\t\t\t\t            unitAmount = rateList[i].unitAmount;\r\n\t\t\t\t            unitDeduct = rateList[i].unitTime;\r\n\t\t                \tlet power = rateList[i].power;\r\n\t\t\t\t            //设置费率信息列表----------lxd\r\n\t\t\t\t            rateHtml = rateHtml+\"<tr><td>\"+power+\"</td><td>\"+unitAmount+\"</td><td>\"+unitDeduct+\"</td></tr>\";\r\n\t\t\t        \t}\r\n\t        \t\t}\r\n\t\t\t\t\trateHtml = rateHtml+\"</tbody></table>\"; \r\n\t\t\t\t\t$(\"#chargeRateList\").html(rateHtml); \r\n\t\t\t\t\tunitAmount = rateList[rateList.length-1].unitAmount;\r\n\t\t            unitDeduct = rateList[rateList.length-1].unitTime;\r\n\t\t\t\t}\r\n\t\t\t}else{//计量模式\r\n\t\t\t\tif(rateList.length>0){\r\n\t\t\t\t\tlet rateHtml = \"<table border='1'>\";\r\n\t\t\t\t\tvar temp=0;\r\n\t\t\t\t\tvar serveTemp=0;\r\n\t\t\t\t\tfor (var i = 0; i < rateList.length; i++) {\r\n\t\t\t\t\t\tif(rateList[i].stepType==\"CHARGE\"){\r\n\t\t\t\t            unitAmount = rateList[i].unitAmount;\r\n\t\t\t\t            unitDeduct = rateList[i].unitTime;\r\n\t\t\t\t\t\t}else if(rateList[i].stepType==\"ELEC\"){\r\n\t\t\t\t\t\t\ttemp=temp+1;\r\n\t\t\t\t\t\t\tif (temp == 1) { // 如果是第一行，显示\"电费\"的单元格\r\n\t\t\t\t\t\t\t\trateHtml = rateHtml + '<tr><td id=\"elecTdFirst\" rowspan=\"1\">电费</td>'; // rowspan 合并\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\trateHtml = rateHtml+'<td>'+rateList[i].beginTime+\" 至 \"+rateList[i].endTime+'</td>';\r\n\t\t\t\t\t\t\t//rateHtml = rateHtml+'<td>'+(rateList[i].unitAmount).toFixed(2)+'元/度</td>';\r\n\t\t\t\t\t\t\t//rateHtml = rateHtml+'</tr>'\r\n\t\t\t\t\t\t\trateHtml = rateHtml+'<td>';\r\n\t\t\t\t\t\t\trateHtml = rateHtml+(rateList[i].unitAmount).toFixed(2);\r\n\t\t\t\t\t\t\trateHtml = rateHtml+'元/度</td></tr>';\r\n\t\t\t\t\t\t}\r\n\t        \t\t}\r\n\t\t\t\t\t//服务费计费方式（0：按每度，1：按时长，2：按每笔）\r\n\t\t\t\t\tif(dpSettleParam.serveType==0){\r\n\t\t\t\t\t\trateHtml = rateHtml+'<tr><td>服务费</td><td colspan=\"2\">';\r\n\t\t\t\t\t\trateHtml = rateHtml+(dpSettleParam.serveUnitFee).toFixed(2)+\"元/度\";\r\n\t\t\t\t\t}else if(dpSettleParam.serveType==1){\r\n\t\t\t\t\t\tfor (var i = 0; i < rateList.length; i++) {\r\n\t\t\t\t\t\t\tif(rateList[i].stepType==\"SERVE\"){\r\n\t\t\t\t\t\t\t\tserveTemp=serveTemp+1;\r\n\t\t\t\t\t\t\t\tif (serveTemp == 1){\r\n\t\t\t\t\t\t\t\t\trateHtml = rateHtml+'<tr><td id=\"serviceTdFirst\" rowspan=\"1\">服务费</td>';\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\trateHtml = rateHtml+'<td>'+(rateList[i].unitAmount).toFixed(2)+ '元/' + rateList[i].unitTime +'分钟</td>';\r\n\t\t\t\t\t\t\t\trateHtml = rateHtml+'<td>' + rateList[i].power + 'W</td></tr>';\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(dpSettleParam.serveType==2){\r\n\t\t\t\t\t\trateHtml = rateHtml+'<tr><td>服务费</td><td colspan=\"2\">';\r\n\t\t\t\t\t\trateHtml = rateHtml+(dpSettleParam.serveUnitFee).toFixed(2)+\"元/笔\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\trateHtml = rateHtml+'</td></tr>';\r\n\t\t\t\t\t//上限\r\n\t\t\t\t\tif (dpSettleParam.serveFeeMax!=null && dpSettleParam.serveFeeMax!=undefined && dpSettleParam.serveFeeMax!=\"\"){\r\n\t\t\t\t\t\trateHtml = rateHtml+'<tr><td>服务费上限</td><td colspan=\"2\">';\r\n\t\t\t\t\t\trateHtml = rateHtml+(dpSettleParam.serveFeeMax).toFixed(2)+\"元\";\r\n\t\t\t\t\t\trateHtml = rateHtml+'</td></tr>';\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif (dpSettleParam.serveFeeMin!=null && dpSettleParam.serveFeeMin!=undefined && dpSettleParam.serveFeeMin!=\"\"){\r\n\t\t\t\t\t\t//下限\r\n\t\t\t\t\t\trateHtml = rateHtml+'<tr><td>服务费下限</td><td colspan=\"2\">';\r\n\t\t\t\t\t\trateHtml = rateHtml+(dpSettleParam.serveFeeMin).toFixed(2)+\"元\";\r\n\t\t\t\t\t\trateHtml = rateHtml+'</td></tr>';\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$(\"#chargeRateList\").html(rateHtml);\r\n\t\t\t\t\t$(\"#elecTdFirst\").attr(\"rowspan\",temp);\r\n\t\t\t\t\t$(\"#serviceTdFirst\").attr(\"rowspan\",serveTemp);\r\n\t\t\t\t}\r\n\t\t\t} \r\n\t\t\tvar minUnitDeduct = 999999;\r\n            var minUnitAmount;\r\n            var minPower;\r\n\t\t\t//遍历费率列表\r\n\t\t\tfor(var i=0;i<data.rateList.length;i++){\r\n\t\t\t\t//判断费率类型\r\n\t\t\t\tif(data.rateList[i].stepType==\"CHARGE\"){\r\n\t\t\t\t\t//功率费率,设置功率对应的费率信息\r\n\t\t\t\t\tunitAmount = data.rateList[i].unitAmount;\r\n\t\t\t\t\tunitDeduct = data.rateList[i].unitTime;\r\n\t\t\t\t\tif(minPower==null){\r\n\t\t\t\t\t\tminPower=data.rateList[i].power;\r\n\t\t\t\t\t\tminUnitDeduct = unitDeduct;\r\n                        minUnitAmount = unitAmount;\r\n\t\t\t\t\t}else if(data.rateList[i].power<minPower){\r\n\t\t\t\t\t\tminPower=data.rateList[i].power;\r\n\t\t\t\t\t\tminUnitDeduct = unitDeduct;\r\n                        minUnitAmount = unitAmount;\r\n\t\t\t\t\t}\r\n\t\t\t\t}else if(data.rateList[i].stepType==\"STORE\"){\r\n\t\t\t\t\t//仓储费率,设置费率信息列表\r\n\t\t            var str =\"<tr><td>\"+data.rateList[i].beginTime+\"-\"+data.rateList[i].endTime+\"</td><td>\"+data.rateList[i].unitAmount+\"</td><td>\"+data.rateList[i].unitTime+\"</td></tr>\"\r\n\t\t            $('#storeRateList').append(str)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tunitDeduct = minUnitDeduct;\r\n            unitAmount = minUnitAmount;\r\n\t\t\t//最小充电选项\r\n\t\t\tvar minChoice = 0;\r\n\t\t\t//充电选项显示内容\r\n\t\t\tvar choiceText = \"\";\r\n\t\t\t//计算最小选项\r\n            minChoice = unitDeduct;\r\n\t\t\t// 判断是否后台设置了充电选项\r\n\t\t\tif(chargeOption.length>0){\r\n\t\t\t\t//遍历生成充电选项\r\n\t\t\t\tfor( var i = 0; i < chargeOption.length; i++ ){\r\n\t\t\t\t\t\t//金额\r\n\t\t\t\t\t\tvar amount = (chargeOption[i]  * unitAmount).toFixed(2);\r\n\t\t\t\t\t\t//数量\r\n\t\t\t\t\t\tvar periodAmount = ( chargeOption[i] * minChoice ).toFixed(0);\r\n\t\t\t\t\t\t//小于60分钟单位为分钟，大于等于60分钟转换为小时+分钟数\r\n\t\t\t\t\t\tif(periodAmount>=60){\r\n\t\t\t\t\t\t\tchoiceText = parseInt(periodAmount/60)+\"小时\";\r\n\t\t\t\t\t\t\tif(periodAmount%60!=0){\r\n\t\t\t\t\t\t\t\tchoiceText = choiceText + periodAmount%60 +\"分钟\";\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tchoiceText = periodAmount+\"分钟\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif( i== (defaultOption-1) ){\r\n\t\t\t\t\t\t\t//默认选中\r\n\t\t\t\t\t\t\titem = $(\"<li><a class='cur' href='javascript:void(0);'  amount='\"+amount+\"' style='overflow: hidden;white-space: nowrap;text-overflow: ellipsis;'><p class='choiceText' style='font-size: small'>\" + choiceText + \"</p><i class='ico ico21'></i> </a></li>\");\r\n\t\t\t\t\t\t\t//设置默认值\r\n\t\t\t\t\t\t\t$(\"#totalFee\").val(amount);\r\n\t\t\t\t\t\t\t$(\"#rechargeText\").html(choiceText+\"　　\"+amount+\"元\");\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\titem = $(\"<li><a href='javascript:void(0);'  amount='\"+amount+\"' style='overflow: hidden;white-space: nowrap;text-overflow: ellipsis;'><p class='choiceText' style='font-size: small'>\" + choiceText + \"</p><i></i> </a></li>\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t$(\"#payAmountUl\").append(item);\r\n\t\t\t\t} \r\n\t\t\t}\r\n\t\t\telse{\r\n\t\t\t\t//遍历生成充电选项\r\n\t\t\t\tfor(var i=1;i<=5;i++){\r\n\t\t\t\t\tif(i==1){\r\n\t\t\t\t\t\t//金额\r\n\t\t\t\t\t\tvar amount = (unitAmount).toFixed(2);\r\n\t\t\t\t\t\t//数量\r\n\t\t\t\t\t\tvar periodAmount = minChoice.toFixed(0);\r\n\t\t\t\t\t\t//小于60分钟单位为分钟，大于等于60分钟转换为小时+分钟数\r\n\t\t\t\t\t\tif(periodAmount>=60){\r\n\t\t\t\t\t\t\tchoiceText = parseInt(periodAmount/60)+\"小时\";\r\n\t\t\t\t\t\t\tif(periodAmount%60!=0){\r\n\t\t\t\t\t\t\t\tchoiceText = choiceText + periodAmount%60 +\"分钟\";\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tchoiceText = periodAmount+\"分钟\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\titem = $(\"<li><a href='javascript:void(0);'  amount='\"+amount+\"' style='overflow: hidden;white-space: nowrap;text-overflow: ellipsis;'><p class='choiceText' style='font-size: small'>\" + choiceText + \"</p><i></i> </a></li>\");\r\n\t\t\t\t\t\t//设置默认值\r\n\t\t\t\t\t\t$(\"#totalFee\").val(amount);\r\n\t\t\t\t\t\t$(\"#rechargeText\").html(choiceText+\"　　\"+amount+\"元\");\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//金额\r\n\t\t\t\t\t\tvar amount = ((Math.pow(2,(i-1)))*unitAmount).toFixed(2);\r\n\t\t\t\t\t\t//数量\r\n\t\t\t\t\t\tvar periodAmount = ((Math.pow(2,(i-1)))*minChoice).toFixed(0);\r\n\t\t\t\t\t\t//小于60分钟单位为分钟，大于等于60分钟转换为小时+分钟数\r\n\t\t\t\t\t\tif(periodAmount>=60){\r\n\t\t\t\t\t\t\tchoiceText = parseInt(periodAmount/60)+\"小时\";\r\n\t\t\t\t\t\t\tif(periodAmount%60!=0){\r\n\t\t\t\t\t\t\t\tchoiceText = choiceText + periodAmount%60 +\"分钟\";\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tchoiceText = periodAmount+\"分钟\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(i==2){\r\n\t\t\t\t\t\t\t//默认选中\r\n\t\t\t\t\t\t\titem = $(\"<li><a class='cur' href='javascript:void(0);'  amount='\"+amount+\"' style='overflow: hidden;white-space: nowrap;text-overflow: ellipsis;'><p class='choiceText' style='font-size: small'>\" + choiceText + \"</p><i class='ico ico21'></i> </a></li>\");\r\n\t\t\t\t\t\t\t//设置默认值\r\n\t\t\t\t\t\t\t$(\"#totalFee\").val(amount);\r\n\t\t\t\t\t\t\t$(\"#rechargeText\").html(choiceText+\"　　\"+amount+\"元\");\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\titem = $(\"<li><a href='javascript:void(0);'  amount='\"+amount+\"' style='overflow: hidden;white-space: nowrap;text-overflow: ellipsis;'><p class='choiceText' style='font-size: small'>\" + choiceText + \"</p><i></i> </a></li>\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$(\"#payAmountUl\").append(item);\r\n\t\t\t\t} \r\n\t\t\t}\r\n\t\t\t\t\r\n\t\t\t$(\"#payAmountUl\").append($(\"<li><a href='javascript:void(0);'  amount='user_define'>自定义<i></i> </a></li>\"));\r\n\t\t\t// 如果设置勾选了充满自停，将第五个充电选项名改为充满自停\r\n\t\t\tif(fullStop==\"on\"){\r\n\t\t\t\tvar obj  = document.getElementsByClassName(\"choiceText\");\r\n\t\t\t\tobj[4].innerHTML=\"充满自停\";\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\t\t//勾选安全防护选项，开始充电,充电成功后取消服务标记\r\n\t\tfunction clearMarkSubmit(){\r\n\t\t\t$(\"#confirmButDivWrapper\").removeClass(\"weui-mask--visible\");\r\n\t\t\t$(\".confirmButDivWrapper\").hide();\r\n\t\t\t//获取选择的通道\r\n\t\t\tvar selectedChannelNo = $(\"#channelUl a.cur\").attr(\"channelId\");\r\n\t\t\t//获取支付金额\r\n\t\t\tvar totalFee = $(\"#totalFee\").val();\r\n\t\t\t//获取会员卡ID，账户支付为0\r\n\t\t\tvar cardId = $(\"#payTypeUl a.cur input\").attr(\"data-values\");\r\n\t\t\tif(cardId !== \"\" && cardId!=\"undefined\"){\r\n\t\t\t\t//启动充电\r\n\t\t\t\tstartDpCharging(selectedChannelNo,totalFee,cardId);\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t\t//点击启动充电按钮\r\n\t\t$(\"#startChargeBtn\").click(function(){\r\n\t\t\t//首先判断安全服务是否被选择(转换为字符串)\r\n\t\t\tvar selfCombustionAmount = $(\"#selfCombustionDiv a.cur\").data(\"value\");\r\n\t\t\tif (selfCombustionAmount!=null && selfCombustionAmount!=undefined && selfCombustionAmount!=\"\"){\r\n\t\t\t\t//选择了安全防护服务，但是点击了普通充电\r\n\t\t\t\t$(\"#confirmButDivWrapper\").addClass(\"weui-mask--visible\");\r\n\t\t\t\t$(\".confirmButDivWrapper\").show();\r\n\t\t\t}else{\r\n\t\t\t\t//获取选择的通道\r\n\t\t\t\tvar selectedChannelNo = $(\"#channelUl a.cur\").attr(\"channelId\");\r\n\t\t\t\t//获取支付金额\r\n\t\t\t\tvar totalFee = $(\"#totalFee\").val();\r\n\t\t\t\t//获取会员卡ID，账户支付为0\r\n\t\t\t\tvar cardId = $(\"#payTypeUl a.cur input\").attr(\"data-values\");\r\n\t\t\t\tif(cardId !== \"\" && cardId!=\"undefined\"){\r\n\t\t\t\t\t//启动充电\r\n\t\t\t\t\tstartDpCharging(selectedChannelNo,totalFee,cardId);\r\n\t\t\t\t}\r\n\t\t\t\t/*else if(selectedPayType == \"wx\"){\r\n                    alert(\"暂不支持微信支付启动充电，请先进行账户充值后使用账户支付方式进行启动充电\");\r\n                }*/\r\n\t\t\t}\r\n\t\t})\r\n\r\n\t\t//点击开始防护充电（不同的是开通加入安全防护的费用）\r\n\t\tfunction startChargeBtnByInsurance(){\r\n\t\t\t$(\"#confirmButDivWrapper\").removeClass(\"weui-mask--visible\");\r\n\t\t\t$(\".confirmButDivWrapper\").hide();\r\n\t\t\t//获取安心充无忧服务选项\r\n\t\t\tvar selfCombustionAmount = $(\"#selfCombustionDiv a.cur\").data(\"value\");\r\n\t\t\tif (selfCombustionAmount!=null && selfCombustionAmount!=undefined && selfCombustionAmount!=\"\"){\r\n\t\t\t\tselfCombustionAmount = parseFloat(selfCombustionAmount) / 100;\r\n\t\t\t\t//获取选择的通道\r\n\t\t\t\tvar selectedChannelNo = $(\"#channelUl a.cur\").attr(\"channelId\");\r\n\t\t\t\t//获取支付金额\r\n\t\t\t\tvar totalFee = $(\"#totalFee\").val();\r\n\t\t\t\t//获取会员卡ID，账户支付为0\r\n\t\t\t\tvar cardId = $(\"#payTypeUl a.cur input\").attr(\"data-values\");\r\n\t\t\t\tif(cardId == \"0\"){\r\n\t\t\t\t\t//启动充电\r\n\t\t\t\t\tstartDpChargingByInsurance(selectedChannelNo,totalFee,cardId,singleMark,selfCombustionAmount,serviceType);\r\n\t\t\t\t}\r\n\t\t\t}else {\r\n\t\t\t\talert(\"请先选择安心充无忧服务选项！\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t//启动充电\r\n\t\tfunction startDpCharging(channelNo,amount,cardId){\r\n\t\t\t//判断金额\r\n\t\t\tif(isNull(amount)||amount<=0){\r\n\t\t\t\t$.alert(\"充电时长不得小于\" + $('#payAmountUl li').eq(0).children('a').html(), \"\",\"\",function(){});\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tif(isNull(channelNo)){\r\n\t\t\t\t$.alert(\"没有可用的通道\",\"\",function(){WeixinJSBridge.call('closeWindow');});\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tvar autoStopFlag = true;\r\n\t\t\t//是否启用充满停止\r\n\t\t\tif(!$(\"#autoStopFlag\").get(0).checked){\r\n\t\t\t\tautoStopFlag = false;\r\n\t\t\t}\r\n\r\n\t\t\t//显示加载等待提示框\r\n\t\t\t$.showLoading();\r\n\t\t\t$.ajax({\r\n\t\t\t\turl : \"startDpCharging.do\",\r\n\t\t\t\tdata : {\r\n\t\t\t\t\t\"GID\" : details.GID,\r\n\t\t\t\t\t\"channelNo\" : channelNo,\r\n\t\t\t\t\t\"chargeAmount\" : amount,\r\n\t\t\t\t\t\"autoStopFlag\" : autoStopFlag,\r\n\t\t\t\t\t\"cardId\":cardId\r\n\t\t\t\t},\r\n\t\t\t\ttimeout : 20000,\r\n\t\t\t\ttype : \"post\",\r\n\t\t\t\tasync : true,\r\n\t\t\t\tdataType : \"text\",\r\n\t\t\t\tsuccess : function(res) {\r\n\t\t\t\t\tvar data = JSON.parse(res);\r\n\t\t\t\t\tif(data.returnCode == \"OUTOFDATE\"){\r\n\t\t\t\t\t\t$.alert(\"网页已过期\",\"提示\",function(){WeixinJSBridge.call('closeWindow');});\r\n\t\t\t\t\t}else if(data.returnCode == \"00\"){\r\n\t\t\t\t\t\t//充电页面url\r\n\t\t\t\t\t\tvar chargeStatusUrl = \"dpBoxChargeStatusPage.do?userId=\"+details.userId+\"&GID=\"+details.GID+\"&channelNo=\"+channelNo+\"&deviceName=\"+details.deviceName;\r\n\t\t\t\t\t\t//进入到充电状态界面\r\n\t\t       \t     \twindow.location.href = chargeStatusUrl;\t\r\n\t\t\t\t\t}else if(data.returnCode == \"06\"){\r\n\t\t\t\t\t\t// 如果选择会员卡支付\r\n\t\t\t\t\t\tif (cardId!=0){\r\n\t\t\t\t\t\t\talert(\"当前会员卡余额不足，请选择其他会员卡或使用账户支付(点击会员卡可选择其他会员卡支付)\");\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t//余额不足,弹出提示是否跳转至充值页面\r\n\t\t\t\t\t\t$.confirm(\"余额不足，是否跳转至充值页面？\", \"提示\", function() {\r\n\t\t\t\t        \t//确认操作，跳转至充值页面\r\n\t\t\t\t        \twindow.location.href=\"acctRechargePage.do?fromPage=dpPage\";\r\n\t\t\t\t        }, function() {\r\n\t\t\t\t          \t//取消操作，关闭页面\r\n\t\t\t\t          \tWeixinJSBridge.call('closeWindow');\r\n\t\t\t\t        });\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//显示提示信息\r\n\t\t\t\t\t\t$.alert(data.returnMsg, \"提示\", function(){\r\n\t\t\t        \t\tWeixinJSBridge.call('closeWindow');\r\n\t\t\t\t        });\r\n\t\t\t\t\t}\r\n\t\t\t\t},\r\n\t\t\t\terror:function(XMLHttpRequest, textStatus, errorThrown){\r\n\t\t\t\t\talert(\"请求异常,请重试：\"+XMLHttpRequest.status+\",\"+textStatus);\r\n\t\t\t\t},\r\n\t\t\t\tcomplete:function(){\r\n\t\t\t\t\t//隐藏加载等待提示框\r\n\t\t\t\t\t$.hideLoading();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\t//启动无忧充电\r\n\t\tfunction startDpChargingByInsurance(channelNo,amount,cardId,singleMark,selfCombustionAmount,serviceType){\r\n\t\t\t//判断金额\r\n\t\t\tif(isNull(amount)||amount<=0){\r\n\t\t\t\t$.alert(\"充电时长不得小于\" + $('#payAmountUl li').eq(0).children('a').html(), \"\",\"\",function(){});\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tif(isNull(channelNo)){\r\n\t\t\t\t$.alert(\"没有可用的通道\",\"\",function(){WeixinJSBridge.call('closeWindow');});\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tvar autoStopFlag = true;\r\n\t\t\t//是否启用充满停止\r\n\t\t\tif(!$(\"#autoStopFlag\").get(0).checked){\r\n\t\t\t\tautoStopFlag = false;\r\n\t\t\t}\r\n\r\n\t\t\t//显示加载等待提示框\r\n\t\t\t$.showLoading();\r\n\t\t\t$.ajax({\r\n\t\t\t\turl : \"startDpChargingByInsurance.do\",\r\n\t\t\t\tdata : {\r\n\t\t\t\t\t\"GID\" : details.GID,\r\n\t\t\t\t\t\"channelNo\" : channelNo,\r\n\t\t\t\t\t\"chargeAmount\" : amount,\r\n\t\t\t\t\t\"autoStopFlag\" : autoStopFlag,\r\n\t\t\t\t\t\"cardId\":cardId,\r\n\t\t\t\t\t\"singleMark\": singleMark,\r\n\t\t\t\t\t\"selfCombustionAmount\": selfCombustionAmount,\r\n\t\t\t\t\t\"serviceType\":serviceType\r\n\t\t\t\t},\r\n\t\t\t\ttimeout : 20000,\r\n\t\t\t\ttype : \"post\",\r\n\t\t\t\tasync : true,\r\n\t\t\t\tdataType : \"text\",\r\n\t\t\t\tsuccess : function(res) {\r\n\t\t\t\t\tvar data = JSON.parse(res);\r\n\t\t\t\t\tif(data.returnCode == \"OUTOFDATE\"){\r\n\t\t\t\t\t\t$.alert(\"网页已过期\",\"提示\",function(){WeixinJSBridge.call('closeWindow');});\r\n\t\t\t\t\t}else if(data.returnCode == \"00\"){\r\n\t\t\t\t\t\t//充电页面url\r\n\t\t\t\t\t\tvar chargeStatusUrl = \"dpBoxChargeStatusPage.do?userId=\"+details.userId+\"&GID=\"+details.GID+\"&channelNo=\"+channelNo+\"&deviceName=\"+details.deviceName;\r\n\t\t\t\t\t\t//进入到充电状态界面\r\n\t\t\t\t\t\twindow.location.href = chargeStatusUrl;\r\n\t\t\t\t\t}else if(data.returnCode == \"06\"){\r\n\t\t\t\t\t\t//余额不足,弹出提示是否跳转至充值页面\r\n\t\t\t\t\t\t$.confirm(\"余额不足，是否跳转至充值页面？\", \"提示\", function() {\r\n\t\t\t\t\t\t\t//确认操作，跳转至充值页面\r\n\t\t\t\t\t\t\twindow.location.href=\"acctRechargePage.do?fromPage=dpPage\";\r\n\t\t\t\t\t\t}, function() {\r\n\t\t\t\t\t\t\t//取消操作，关闭页面\r\n\t\t\t\t\t\t\tWeixinJSBridge.call('closeWindow');\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//显示提示信息\r\n\t\t\t\t\t\t$.alert(data.returnMsg, \"提示\", function(){\r\n\t\t\t\t\t\t\tWeixinJSBridge.call('closeWindow');\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t},\r\n\t\t\t\terror:function(XMLHttpRequest, textStatus, errorThrown){\r\n\t\t\t\t\talert(\"请求异常,请重试：\"+XMLHttpRequest.status+\",\"+textStatus);\r\n\t\t\t\t},\r\n\t\t\t\tcomplete:function(){\r\n\t\t\t\t\t//隐藏加载等待提示框\r\n\t\t\t\t\t$.hideLoading();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\t//删除安心充流水\r\n\t\tfunction deleteInsuranceFlow(insuranceFlowId){\r\n\t\t\tif (insuranceFlowId!=undefined){\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl : \"updateInsuranceFlow.do\",\r\n\t\t\t\t\tdata : {\r\n\t\t\t\t\t\t\"insuranceFlowId\" : insuranceFlowId\r\n\t\t\t\t\t},\r\n\t\t\t\t\ttimeout : 20000,\r\n\t\t\t\t\ttype : \"post\",\r\n\t\t\t\t\tasync : true,\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t//选择通道\r\n\t\t$(document).on(\"click\",\"#channelUl .usable\",function(){\r\n\t\t\tchannelId = $(this).attr(\"channelId\");\r\n\t\t\t$(\"#channelUl a\").removeClass(\"cur\");\r\n\t\t\t$(\"#channelUl i\").removeClass(\"ico\").removeClass(\"ico21\");\r\n\t\t\t$(this).addClass(\"cur\");\r\n\t\t\t$(this).find(\"i\").addClass(\"ico\").addClass(\"ico21\");\r\n\t\t})\r\n\t\t\r\n\t\t//选择充电选项\r\n\t\t$(document).on(\"click\",\"#payAmountUl a\",function(){\r\n\t\t\tvar payAmount = $(this).attr(\"amount\");\r\n\t\t\tif(payAmount==\"user_define\"){\r\n\t\t\t\t$(\"#totalAmount\").val(\"\");\r\n\t\t\t\t$(\"#totalAmountHour\").val(\"\");\r\n\t\t\t\t$(\"#totalAmountMin\").val(\"\");\r\n\t\t\t\t$(\"#totalFee\").val(\"\");\r\n\t\t\t\t$(\"#rechargeText\").html(\"\");\r\n\t\t\t\t$(\"#userDefineAmountDiv\").show();\r\n\t\t\t}else{\r\n\t\t\t\t$(\"#totalFee\").val(payAmount);\r\n\t\t\t\t$(\"#rechargeText\").html($(this).html()+\"　　\"+payAmount+\"元\");\r\n\t\t\t\t$(\"#userDefineAmountDiv\").hide();\r\n\t\t\t}\r\n\t\t\t$(\"#payAmountUl a\").removeClass(\"cur\");\r\n\t\t\t$(\"#payAmountUl i\").removeClass(\"ico\").removeClass(\"ico21\");\r\n\t\t\t$(this).addClass(\"cur\");\r\n\t\t\t$(this).find(\"i\").addClass(\"ico\").addClass(\"ico21\");\r\n\t\t});\r\n\r\n\t\t// 选择支付方式\r\n\t\t$(document).on(\"click\",\"#payTypeUl a\",function(){\r\n\t\t\t$(\"#payTypeUl a\").removeClass(\"cur\");\r\n\t\t\t$(\"#payTypeUl i\").removeClass(\"ico\").removeClass(\"ico21\");\r\n\t\t\t$(this).addClass(\"cur\");\r\n\t\t\t$(this).find(\"i\").addClass(\"ico\").addClass(\"ico21\");\r\n\t\t});\r\n\r\n\t\t//输入自定义数量\r\n\t\t$(\"#userDefineAmountDiv input\").bind(\"input propertychange\",function(){\r\n\t\t\t$(\"#rechargeText\").html(\"\");\r\n\t\t\t//充电总数量\r\n\t\t\tvar amount=0;\r\n\t\t\t//格式化输入的小时、分钟数\r\n\t\t\t$(\"#totalAmountHour\").val(formatNum($(\"#totalAmountHour\").val(),0,100000));\r\n\t\t\t$(\"#totalAmountMin\").val(formatNum($(\"#totalAmountMin\").val(),0,59));\r\n\t\t\t//获取小时、分钟数\r\n\t\t\tvar totalAmountHour = $(\"#totalAmountHour\").val();\r\n\t\t\tvar totalAmountMin = $(\"#totalAmountMin\").val();\r\n\t\t\tif(totalAmountHour==0&&totalAmountMin==0){\r\n\t\t\t\t$(\"#rechargeText\").html(\"请输入充电时长\");\r\n\t\t\t\t$(\"#totalFee\").val(0);\r\n\t\t\t\treturn;\r\n\t\t\t}else{\r\n\t\t\t\tif(!isNull(totalAmountHour)){\r\n\t\t\t\t\tamount = parseInt(totalAmountHour)*60;\r\n\t\t\t\t}\r\n\t\t\t\tif(!isNull(totalAmountMin)){\r\n\t\t\t\t\tamount = amount + parseInt(totalAmountMin);\r\n\t\t\t\t}\r\n\t\t\t\t/*//判断输入的数值是否为对应费率周期的整数倍\r\n\t\t\t\tif(amount%unitDeduct!=0){\r\n\t\t\t\t\tamount = amount-amount%unitDeduct;\r\n\t\t\t\t}*/\r\n\t\t\t\t//分钟数转换为小时+分钟数\r\n\t\t\t\tvar rechargeText;\r\n\t\t\t\tif(amount>=60){\r\n\t\t\t\t\trechargeText = parseInt(amount/60)+\"小时\";\r\n\t\t\t\t\tif(amount%60!=0){\r\n\t\t\t\t\t\trechargeText = rechargeText + amount%60 +\"分钟\";\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\trechargeText = amount+\"分钟\";\r\n\t\t\t\t}\r\n\t\t\t\t//计算对应金额\r\n\t\t\t\tvar money = ((amount/unitDeduct)*unitAmount).toFixed(2);\r\n\t\t\t\t$(\"#totalFee\").val(money);\r\n\t\t\t\t$(\"#rechargeText\").html(rechargeText+\"　　\"+money+\"元\");\r\n\t\t\t}\r\n\t\t})\r\n\t\t//点击查看费率\r\n\t\t$(\"#RateUl li\").each(function(){\r\n\t\t\t$(this).click(function(){\r\n\t\t\t\tvar selectedId = $(this).attr(\"id\")\r\n\t\t\t\tif(selectedId==\"chargeRateLi\"){\r\n\t\t\t\t$('.chargeRateWrapper').show()\r\n\t\t\t\t}else if(selectedId==\"storeRateLi\"){\r\n\t\t\t\t$('.chargeRateWrapper').show()\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t})\r\n\t\t$('.chargeRateBtn').click(function () {\r\n      $('.chargeRateWrapper').hide()\r\n    })\r\n\tfunction colseChargeRateWrapper(){\r\n\t\t$('.chargeRateWrapper').hide()\r\n\t}\r\n</script>\r\n</html>"},"redirectURL":"","headersSize":156,"bodySize":51613,"_status":"completed","_startTimestamp